-- Lógica para arrastrar el cubo
local arrastrando = false

SliderCubo.MouseButton1Down:Connect(function()
    arrastrando = true
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        arrastrando = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if arrastrando and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local posAbsolutaBarra = SliderBarra.AbsolutePosition.X
        local tamanoAbsolutoBarra = SliderBarra.AbsoluteSize.X
        local mouseX = input.Position.X

        local porcentaje = math.clamp((mouseX - posAbsolutaBarra) / tamanoAbsolutoBarra, 0, 1)
        SliderCubo.Position = UDim2.new(porcentaje, -8, -0.8, 0)

        -- Escala: 1 metro (3.3 studs) hasta 10 metros (33 studs)
        local metros = math.floor(1 + (porcentaje * 9))
        distanciaStuds = math.floor(metros * 3.3)
        SliderLabel.Text = "DISTANCIA: " .. tostring(metros) .. " METROS"
    end
end)

-- 4. Bucle principal con distancia dinámica según el slider
task.spawn(function()
    while task.wait() do
        if autoFarm then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local enemigo = obtenerEnemigoCercano()
                    
                    if enemigo and enemigo:FindFirstChild("HumanoidRootPart") then
                        equiparArma()

                        local hrpEnemigo = enemigo.HumanoidRootPart
                        -- Se aplica la distancia en studs elegida con el cubo
                        char.HumanoidRootPart.CFrame = hrpEnemigo.CFrame * CFrame.new(0, 1, distanciaStuds)

                        for _, parte in pairs(char:GetChildren()) do
                            if parte:IsA("BasePart") then
                                parte.CanCollide = false
                            end
                        end

                        VirtualUser:CaptureController()
                        VirtualUser:ClickButton1(Vector2.new(500, 500))
                    end
                end
            end)
        end
    end
end)
