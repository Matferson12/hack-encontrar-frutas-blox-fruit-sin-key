-- Auto Farm Híbrido con Slider de Distancia para Xeno
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local VirtualUser = game:GetService("VirtualUser")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local autoFarm = false
local modoArma = "Punos" -- Opciones: "Punos" o "Espada"
local distanciaStuds = 20 -- Distancia por defecto (~6 metros)

-- 1. Equipar el tipo de arma seleccionado
local function equiparArma()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not char or not bp then return end

    if modoArma == "Punos" then
        local estilos = {"Combat", "Black Leg", "Electro", "Fishman Karate", "Dragon Claw", "Superhuman", "Death Step", "Sharkman Karate", "Electric Claw", "Dragon Talon", "Godhuman", "Sanguine Art"}
        for _, item in pairs(bp:GetChildren()) do
            if item:IsA("Tool") then
                for _, nombreEstilo in pairs(estilos) do
                    if string.find(string.lower(item.Name), string.lower(nombreEstilo)) then
                        char.Humanoid:EquipTool(item)
                        return
                    end
                end
            end
        end
    elseif modoArma == "Espada" then
        for _, item in pairs(bp:GetChildren()) do
            if item:IsA("Tool") and item:FindFirstChild("ToolTip") and item.ToolTip == "Sword" then
                char.Humanoid:EquipTool(item)
                return
            end
        end
    end
end

-- 2. Buscar enemigo más cercano
local function obtenerEnemigoCercano()
    local menorDist = math.huge
    local objetivo = nil
    local char = LocalPlayer.Character

    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end

    local carpetaEnemigos = Workspace:FindFirstChild("Enemies") or Workspace
    for _, npc in pairs(carpetaEnemigos:GetChildren()) do
        local hum = npc:FindFirstChild("Humanoid")
        local hrp = npc:FindFirstChild("HumanoidRootPart")
        
        if hum and hrp and hum.Health > 0 and not Players:GetPlayerFromCharacter(npc) then
            local dist = (char.HumanoidRootPart.Position - hrp.Position).Magnitude
            if dist < menorDist then
                menorDist = dist
                objetivo = npc
            end
        end
    end
    return objetivo
end

