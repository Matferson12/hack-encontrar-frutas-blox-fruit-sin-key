local function limpiarLineas()
    for _, l in pairs(lineas) do
        if l then l:Remove() end
    end
    lineas = {}
end

-- Dibujar líneas con colores según la rareza
RunService.RenderStepped:Connect(function()
    limpiarLineas()
    if not activo then return end

    for _, obj in pairs(Workspace:GetChildren()) do
        if esFruta(obj) then
            local parte = obj:FindFirstChild("Handle") or obj:FindFirstChildOfClass("BasePart")
            if parte then
                local posFruta, visible = Camera:WorldToViewportPoint(parte.Position)
                if visible then
                    local colorRareza, _ = obtenerInfoRareza(obj.Name)
                    local linea = Drawing.new("Line")
                    linea.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    linea.To = Vector2.new(posFruta.X, posFruta.Y)
                    linea.Color = colorRareza
                    linea.Thickness = 2.5
                    linea.Transparency = 1
                    linea.Visible = true
                    table.insert(lineas, linea)
                end
            end
        end
    end
end)

Boton.MouseButton1Click:Connect(function()
    activo = not activo
    if activo then
        Boton.Text = "DESACTIVAR"
        Boton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    else
        Boton.Text = "ACTIVAR"
        Boton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        limpiarLineas()
    end
end)

-- TP inteligente: busca la fruta de mayor rareza primero
BotonTP.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    local mejorFruta = nil
    local maxPrioridad = -1

    for _, obj in pairs(Workspace:GetChildren()) do
        if esFruta(obj) then
            local parte = obj:FindFirstChild("Handle") or obj:FindFirstChildOfClass("BasePart")
            if parte then
                local _, prioridad = obtenerInfoRareza(obj.Name)
                if prioridad > maxPrioridad then
                    maxPrioridad = prioridad
                    mejorFruta = parte
                end
            end
        end
    end

    if mejorFruta then
        char.HumanoidRootPart.CFrame = mejorFruta.CFrame * CFrame.new(0, 3, 0)
    end
end)
