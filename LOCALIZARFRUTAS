-- Script Detector de Frutas por Rareza + TP Prioritario para Xeno
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local activo = false
local lineas = {}

-- Tabla de rarezas y sus colores
local RAREZAS = {
    Mitica = {
        Color = Color3.fromRGB(255, 0, 128), -- Rosado / Magenta brillante
        Prioridad = 5,
        Frutas = {"kitsune", "dragon", "leopard", "dough", "t-rex", "spirit", "venom", "shadow", "blizzard", "gravity", "mammoth"}
    },
    Legendaria = {
        Color = Color3.fromRGB(255, 170, 0), -- Dorado / Naranja
        Prioridad = 4,
        Frutas = {"portal", "rumble", "buddha", "phoenix", "sound", "pain", "love", "spider", "magma", "ghost"}
    },
    Rara = {
        Color = Color3.fromRGB(170, 0, 255), -- Morado
        Prioridad = 3,
        Frutas = {"light", "dark", "ice", "sand", "diamond", "barrier", "rubber"}
    },
    PocoComun = {
        Color = Color3.fromRGB(0, 170, 255), -- Azul
        Prioridad = 2,
        Frutas = {"flame", "falcon", "spike", "smoke", "bomb", "spring"}
    },
    Comun = {
        Color = Color3.fromRGB(150, 150, 150), -- Gris
        Prioridad = 1,
        Frutas = {"rocket", "spin", "chop"}
    }
}

-- Clasificar fruta
local function obtenerInfoRareza(nombreObjeto)
    local nom = string.lower(nombreObjeto)
    
    for _, datos in pairs(RAREZAS) do
        for _, fNom in pairs(datos.Frutas) do
            if string.find(nom, fNom) then
                return datos.Color, datos.Prioridad
            end
        end
    end
    -- Si no está en la lista pero es fruta, se asigna como Mítica/Desconocida para no perderla
    return Color3.fromRGB(0, 255, 127), 3
end

-- Verificar si el objeto es fruta
local function esFruta(obj)
    if obj:IsA("Tool") or obj:IsA("Model") then
        local nom = string.lower(obj.Name)
        if string.find(nom, "fruit") or string.find(nom, "fruta") or obj:FindFirstChild("Handle") then
            if not obj:IsDescendantOf(Players) then
                return true
            end
        end
    end
    return false
end

